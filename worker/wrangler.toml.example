# wrangler.toml.example — copie para wrangler.toml e ajuste.
# Deploy: wrangler deploy   |   Dev local: wrangler dev
# Passo a passo completo (conta zerada → produção): ../docs/DEPLOY.md

name = "kilo-passaporte"
main = "src/index.js"
compatibility_date = "2026-09-07"
workers_dev = true
minify = true

[placement]
mode = "smart"

# Static Assets: landing estática servida de ./public pela borda.
[assets]
directory = "./public"

[[d1_databases]]
binding = "DB"
database_name = "kilo-passaporte"
database_id = "00000000-0000-0000-0000-000000000000" # <- substitua pelo id retornado no create
migrations_dir = "migrations"

[vars]
# Em produção: allowlist (sem *). Same-origin landing+API não precisa de CORS amplo.
ALLOWED_ORIGINS = "https://kilo.ia.br,http://localhost:8787,http://127.0.0.1:8787"

[observability]
enabled = true

# Chave Ed25519: wrangler secret put SIGNING_KEY_JWK — NUNCA neste arquivo.
# Rotação: SIGNING_KEY_JWK_PREVIOUS — ver ../docs/RUNBOOK-CHAVE.md.

# Domínio próprio (opcional):
# [[routes]]
# pattern = "kilo.ia.br"
# custom_domain = true
